{
    "api_settings": {
        "url": "https://sandbox-api.saasquatchleads.com/scraper/scrape-stream",
        "timeout": 600,
        "headers": {
            "Content-Type": "application/json"
        }
    },
    "resource_limits": {
        "max_memory_percent": 90.0,
        "max_cpu_percent": 90.0,
        "max_workers": 1,
