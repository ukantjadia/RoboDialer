        "password": "developer123"
    },
    "output_settings": {
        "save_intermediate_results": true,
        "save_errors_separately": true,
        "log_level": "INFO"
    },
    "processing_settings": {
        "check_interval": 10.0,
        "progress_log_interval": 5
    }
}