# Production Environment Variables
# Copy this file to .env and fill in your actual values

# Database
DATABASE_URL=postgresql://username:password@host:port/database

# Backend URLs (update with your actual domain/IP)
NEXT_PUBLIC_BASE_URL=https://your-domain.com
NEXT_PUBLIC_API_BASE_URL=https://your-domain.com

# Twilio Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_API_KEY_SID=your_twilio_api_key_sid
TWILIO_API_SECRET=your_twilio_api_secret
TWILIO_TWIML_APP_SID=your_twiml_app_sid
TWILIO_CALLER_ID=your_twilio_phone_number

# Frontend Twilio Configuration (same as backend)
NEXT_PUBLIC_TWILIO_ACCOUNT_SID=your_twilio_account_sid
NEXT_PUBLIC_TWILIO_AUTH_TOKEN=your_twilio_auth_token
NEXT_PUBLIC_TWILIO_API_KEY_SID=your_twilio_api_key_sid
NEXT_PUBLIC_TWILIO_API_SECRET=your_twilio_api_secret
NEXT_PUBLIC_TWILIO_TWIML_APP_SID=your_twiml_app_sid
NEXT_PUBLIC_TWILIO_CALLER_ID=your_twilio_phone_number