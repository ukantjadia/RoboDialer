# =================================================================
# 🤖 ROBODIALER ENVIRONMENT CONFIGURATION
# =================================================================
# Copy this file to .env and fill in your actual values

# =================================================================
# 📞 TWILIO CREDENTIALS (REQUIRED)
# =================================================================
# Get these from your Twilio Console (https://console.twilio.com/)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=your_twilio_api_secret_here
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_CALLER_ID=+1234567890
TARGET_PHONE_NUMBER=+1234567890

# =================================================================
# 🌐 NGROK URLS (UPDATE AFTER STARTING NGROK)
# =================================================================
# Get your ngrok URL after running: ngrok http 8000
# Example: https://abc123def.ngrok-free.app
NGROK_URL=https://your-ngrok-url.ngrok-free.app
BASE_URL=https://your-ngrok-url.ngrok-free.app

# =================================================================
# 🗄️ DATABASE CONFIGURATION
# =================================================================
# Railway PostgreSQL (current production setup)
DATABASE_URL=postgresql://postgres:your_password@host:port/database

# =================================================================
# 🤖 AI SERVICE KEYS (OPTIONAL BUT RECOMMENDED)
# =================================================================
# DeepSeek for conversational AI
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# Deepgram for speech-to-text
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Cartesia for text-to-speech
CARTESIA_API_KEY=sk_car_your_cartesia_key_here
CARTESIA_URL=https://api.cartesia.ai/tts/bytes

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API=your_gemini_api_key_here

# =================================================================
# 🔧 APPLICATION SETTINGS
# =================================================================
# Frontend Configuration
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Application Environment
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=your_secret_key_here_change_this_in_production
PRIVATE_KEY=your_secret_private_key

# JWT Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# =================================================================
# 📧 EMAIL SERVICE CONFIGURATION
# =================================================================
# Gmail SMTP (for follow-up emails)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here
MAIL_DEFAULT_SENDER=your_email@gmail.com

# =================================================================
# 🔗 SETUP INSTRUCTIONS
# =================================================================
# 1. Get Twilio credentials:
#    - Sign up at https://www.twilio.com/
#    - Get Account SID, Auth Token from Console Dashboard
#    - Create API Key for API_KEY_SID and API_SECRET
#    - Create TwiML App for TWIML_APP_SID
#    - Verify your phone number for TWILIO_CALLER_ID
#
# 2. Get ngrok URL:
#    - Install ngrok: winget install ngrok.ngrok
#    - Run: ngrok http 8000
#    - Copy the https URL and update NGROK_URL and BASE_URL
#
# 3. Configure Twilio Webhooks:
#    - Go to TwiML Apps in Twilio Console
#    - Set Voice URL: https://your-ngrok-url.ngrok-free.app/api/twilio/voice
#    - Set Status Callback: https://your-ngrok-url.ngrok-free.app/api/twilio/status
#
# 4. Optional AI Services:
#    - DeepSeek: https://platform.deepseek.com/
#    - Deepgram: https://console.deepgram.com/
#    - Cartesia: https://cartesia.ai/
#    - Google AI: https://makersuite.google.com/
#
# =================================================================