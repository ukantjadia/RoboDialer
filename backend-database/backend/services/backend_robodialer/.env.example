# Frontend Configuration
NEXT_PUBLIC_BASE_URL=https://your-ngrok-url.ngrok-free.app
GEMINI_API_KEY=your_gemini_api_key_here

# Database
DATABASE_URL=postgresql://postgres:your_password@your_host:port/your_database

# DeepSeek & AI
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPGRAM_API_KEY=your_deepgram_api_key_here
CARTESIA_API_KEY=your_cartesia_api_key_here
CARTESIA_URL=https://api.cartesia.ai/tts/bytes

# Twilio Credentials
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_API_KEY_SID=your_twilio_api_key_sid
TWILIO_API_SECRET=your_twilio_api_secret
TWILIO_TWIML_APP_SID=your_twiml_app_sid
TWILIO_CALLER_ID=your_twilio_phone_number
TARGET_PHONE_NUMBER=your_target_phone_number
PRIVATE_KEY=your_secret_private_key

# Public URLs for Webhooks - IMPORTANT: Replace with your ngrok URL
# Get your ngrok URL by running: ngrok http 8000
NGROK_URL=https://your-ngrok-url.ngrok-free.app
BASE_URL=https://your-ngrok-url.ngrok-free.app

# Google API / Gemini
GEMINI_API=your_gemini_api_key_here

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=your_secret_key_here_change_this_in_production

# JWT
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Email Service
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_DEFAULT_SENDER=your_email@gmail.com